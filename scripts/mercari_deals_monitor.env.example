# Optional override if `cari` is not on PATH.
CARI_BIN=cari

# market-api base URL.
MARKET_API_BASE_URL=http://127.0.0.1:18080

# Webhooks
GENERAL_WEBHOOK_URL=
DEALS_WEBHOOK_URL=
DISCORD_USERNAME=Mercari Deals Monitor

# Mercari search terms. Defaults cover OP/EB/PRB set prefixes if omitted.
SEARCH_TERMS=
SEARCH_LIMIT=40
HYDRATE_LIMIT=25
STATE_FILE=state/mercari_deals_monitor.json
BOOTSTRAP_ON_EMPTY_STATE=true
MAX_SEEN=10000

# Timing
COMMAND_TIMEOUT_SEC=25
RESOLVE_TIMEOUT_SEC=30
WEBHOOK_TIMEOUT_SEC=10
WEBHOOK_PAUSE_MS=250

# Deal thresholds
MIN_ROI=0.30
MIN_CONFIDENCE=0.80
BUYER_FEE_PERCENT=0.036
DEFAULT_SHIPPING_USD=1.50

# Testing
DRY_RUN=false
